\newlabel{tab:ladder}{{2}{7}{\textbf {Correction ladder by individual and gap (linear decoder, tuned penalty $\alpha = 10^4$).} Median decoding $R^2$ for each rung, and median retention of the renormalized fixed decoder with 95\% cluster-bootstrap confidence intervals. Each training session contributes at most one pair per gap. Supervised rungs used up to 300 labeled trials. Aligned, Procrustes rotation after renormalization; stable aligned, the same estimated from stable channels}{table.2}{}}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces \textbf  {Label-free corrections.} Median over training sessions of the paired difference in $R^2$ (pairs at gaps up to 120 days for alignment, all gaps for CORAL and the stabilizer), with two-sided Wilcoxon signed-rank $P$ in parentheses. Mean, mean updating only; rot., Procrustes rotation; stab., factor-analysis stabilizer; FA, factor analysis.}}{8}{table.3}\protected@file@percent }
\newlabel{tab:labelfree}{{3}{8}{\textbf {Label-free corrections.} Median over training sessions of the paired difference in $R^2$ (pairs at gaps up to 120 days for alignment, all gaps for CORAL and the stabilizer), with two-sided Wilcoxon signed-rank $P$ in parentheses. Mean, mean updating only; rot., Procrustes rotation; stab., factor-analysis stabilizer; FA, factor analysis}{table.3}{}}
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces \textbf  {Monitoring.} \textbf  {a}, Offline, monkey N (537 pairs): Spearman correlation with decoder $R^2$, raw and partial given log elapsed days, and time-blocked cross-validated error of predicted $R^2$ (days and divergence uses both divergences). \textbf  {b}, Closed loop, public MINDFUL data: Pearson correlation of angular error with elapsed days and each divergence (raw and partial given days), and leave-one-day-out mean absolute error (degrees).}}{9}{table.4}\protected@file@percent }
\newlabel{tab:mindful}{{4}{9}{\textbf {Monitoring.} \textbf {a}, Offline, monkey N (537 pairs): Spearman correlation with decoder $R^2$, raw and partial given log elapsed days, and time-blocked cross-validated error of predicted $R^2$ (days and divergence uses both divergences). \textbf {b}, Closed loop, public MINDFUL data: Pearson correlation of angular error with elapsed days and each divergence (raw and partial given days), and leave-one-day-out mean absolute error (degrees)}{table.4}{}}
\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces \textbf  {Channel controls and electrode link.} For 40 training sessions per individual (tuned penalty), median retention of the renormalized fixed decoder, after re-weighting the correctly assigned decoder, after re-weighting a decoder with scrambled channels, and the same two with non-negative weights. Electrode link (humans): median over training sessions of the Spearman correlation between fitted channel weights and the change in each electrode's log threshold-crossing rate or log impedance between the two days, with the share of sessions with a positive correlation.}}{10}{table.5}\protected@file@percent }
\newlabel{tab:controls}{{5}{10}{\textbf {Channel controls and electrode link.} For 40 training sessions per individual (tuned penalty), median retention of the renormalized fixed decoder, after re-weighting the correctly assigned decoder, after re-weighting a decoder with scrambled channels, and the same two with non-negative weights. Electrode link (humans): median over training sessions of the Spearman correlation between fitted channel weights and the change in each electrode's log threshold-crossing rate or log impedance between the two days, with the share of sessions with a positive correlation}{table.5}{}}
