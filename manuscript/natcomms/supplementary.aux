\newlabel{tab:angles}{{8}{12}{\textbf {Angles between decoders fitted on different days} (degrees, medians over pairs). Global, angle that allows one global scale; per channel, angle after fitting one scale per channel; permuted, the per-channel angle after randomly permuting the channels of the earlier decoder}{table.8}{}}
\@writefile{lot}{\contentsline {table}{\numberline {9}{\ignorespaces \textbf  {Regularization by the 1\% rule.} The rule chose the largest ridge penalty whose median same-day $R^2$ was within 1\% of the best. Columns give median $R^2$ with $\alpha = 0.1$ and with the chosen $\alpha $, the median paired gain with 95\% cluster-bootstrap confidence interval, and the share of training sessions whose mean gain was positive.}}{13}{table.9}\protected@file@percent }
\newlabel{tab:reg}{{9}{13}{\textbf {Regularization by the 1\% rule.} The rule chose the largest ridge penalty whose median same-day $R^2$ was within 1\% of the best. Columns give median $R^2$ with $\alpha = 0.1$ and with the chosen $\alpha $, the median paired gain with 95\% cluster-bootstrap confidence interval, and the share of training sessions whose mean gain was positive}{table.9}{}}
\@writefile{lot}{\contentsline {table}{\numberline {10}{\ignorespaces \textbf  {Recalibration with few labeled trials.} \textbf  {a}, Monkey N (86 pairs): median retention without labels and, for each number of labeled trials, ridge to prior / fresh decoder / re-weighting (regularization by cross-validation). \textbf  {b}, Human participants (30 training sessions each, all gaps): re-weighting / ridge to prior / fresh decoder. \textbf  {c}, Harmful recalibrations in monkey N (more than 0.01 $R^2$ below the renormalized fixed decoder) with the shrinkage chosen by cross-validation or fixed at the value best on other training sessions, with exact McNemar $P$, and median retention for both and for the best value in hindsight.}}{14}{table.10}\protected@file@percent }
\newlabel{tab:recal}{{10}{14}{\textbf {Recalibration with few labeled trials.} \textbf {a}, Monkey N (86 pairs): median retention without labels and, for each number of labeled trials, ridge to prior / fresh decoder / re-weighting (regularization by cross-validation). \textbf {b}, Human participants (30 training sessions each, all gaps): re-weighting / ridge to prior / fresh decoder. \textbf {c}, Harmful recalibrations in monkey N (more than 0.01 $R^2$ below the renormalized fixed decoder) with the shrinkage chosen by cross-validation or fixed at the value best on other training sessions, with exact McNemar $P$, and median retention for both and for the best value in hindsight}{table.10}{}}
\@writefile{lot}{\contentsline {table}{\numberline {11}{\ignorespaces \textbf  {Electrode statistics.} \textbf  {a}, Silence and recovery in initially active human electrodes under different definitions, observed and after shuffling each electrode's session order (shuffled silent episodes in parentheses). \textbf  {b}, Per array: yield is the percentage of electrodes with a threshold-crossing rate of at least 2~Hz (median of the first / last three sessions); $h_{\mathrm  {off}}$ and $h_{\mathrm  {on}}$ are switching rates per 1,000 days; Rev./sil., recovered and silenced initially active electrodes; Kurt., excess kurtosis of session-to-session changes in log rate after removing session-wide changes; Imp.\ $\rho $, Spearman correlation of the array median impedance with day; Edge $-$ int., median edge minus median interior slope of log rate per year, with the one-sided Mann--Whitney $P$ (electrodes treated as independent; see main text for array-level tests).}}{15}{table.11}\protected@file@percent }
\newlabel{tab:electrodes}{{11}{15}{\textbf {Electrode statistics.} \textbf {a}, Silence and recovery in initially active human electrodes under different definitions, observed and after shuffling each electrode's session order (shuffled silent episodes in parentheses). \textbf {b}, Per array: yield is the percentage of electrodes with a threshold-crossing rate of at least 2~Hz (median of the first / last three sessions); $h_{\mathrm {off}}$ and $h_{\mathrm {on}}$ are switching rates per 1,000 days; Rev./sil., recovered and silenced initially active electrodes; Kurt., excess kurtosis of session-to-session changes in log rate after removing session-wide changes; Imp.\ $\rho $, Spearman correlation of the array median impedance with day; Edge $-$ int., median edge minus median interior slope of log rate per year, with the one-sided Mann--Whitney $P$ (electrodes treated as independent; see main text for array-level tests)}{table.11}{}}
\@writefile{lot}{\contentsline {table}{\numberline {12}{\ignorespaces \textbf  {Simulator parameters.} Values calibrated on monkey N sessions before day 700 (early) and from day 700 onwards (late). Switching rates were measured from electrode activity in each period. Fixed parameters: local mixing share $\beta = 0.5$, turnover concentration 5, 20 latent dimensions and silent-signal fraction $\kappa = 0.37$.}}{16}{table.12}\protected@file@percent }
\newlabel{tab:sim}{{12}{16}{\textbf {Simulator parameters.} Values calibrated on monkey N sessions before day 700 (early) and from day 700 onwards (late). Switching rates were measured from electrode activity in each period. Fixed parameters: local mixing share $\beta = 0.5$, turnover concentration 5, 20 latent dimensions and silent-signal fraction $\kappa = 0.37$}{table.12}{}}
\@writefile{lot}{\contentsline {table}{\numberline {13}{\ignorespaces \textbf  {Training on simulated futures.} Median $R^2$ on real later sessions of monkey N for ridge decoders trained on sessions after day 700 (simulator calibrated before day 700). Base, $\alpha = 0.1$; stronger ridge, $\alpha = 10^4$; perturbation, random channel dropout and gain noise; simulator, eight simulated futures; simulator and ridge, both; several days, data from the three previous sessions; reference, decoder trained on the test day.}}{16}{table.13}\protected@file@percent }
\newlabel{tab:augment}{{13}{16}{\textbf {Training on simulated futures.} Median $R^2$ on real later sessions of monkey N for ridge decoders trained on sessions after day 700 (simulator calibrated before day 700). Base, $\alpha = 0.1$; stronger ridge, $\alpha = 10^4$; perturbation, random channel dropout and gain noise; simulator, eight simulated futures; simulator and ridge, both; several days, data from the three previous sessions; reference, decoder trained on the test day}{table.13}{}}
